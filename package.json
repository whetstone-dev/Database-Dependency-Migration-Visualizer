{
  "name": "database-dependency-migration",
  "version": "0.3.2",
  "description": "Evidence-backed PostgreSQL dependencies and review-only migration analysis",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@12.10.1",
  "bin": {
    "dbdep": "scripts/dbdep.mjs"
  },
  "exports": {
    ".": "./src/dbdep/engine.mjs"
  },
  "files": [
    "src/dbdep/*.mjs",
    "scripts/*.mjs",
    "schemas",
    "assets/viewer",
    "examples",
    "references",
    "SKILL.md",
    "agents",
    "templates",
    "README.md",
    "pnpm-lock.yaml",
    "LICENSE",
    "SECURITY.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "dbdep": "node scripts/dbdep.mjs",
    "test": "node --test tests/node/*.test.mjs",
    "test:browser": "playwright test",
    "test:live": "node scripts/fixture-cluster.mjs",
    "build": "pnpm --filter database-dependency-migration-site build",
    "dev": "pnpm --filter database-dependency-migration-site dev",
    "preview": "pnpm --filter database-dependency-migration-site preview",
    "demo": "node scripts/dbdep.mjs demo examples/rendered --json",
    "verify:examples": "node scripts/verify-examples.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "package:skill": "node scripts/package-skill.mjs",
    "package:site": "node scripts/package-site.mjs",
    "smoke:artifacts": "node scripts/smoke-artifacts.mjs",
    "smoke:skills": "node scripts/smoke-skills-install.mjs",
    "check:site": "node scripts/check-site-publication.mjs",
    "format": "prettier --write src/dbdep/*.mjs scripts/*.mjs tests/node/*.mjs tests/browser/*.mjs assets/viewer/*.{css,js,html}"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "commander": "15.0.0",
    "libpg-query": "18.1.5",
    "pg": "8.23.1",
    "pg-connection-string": "2.14.1"
  },
  "devDependencies": {
    "@playwright/test": "1.56.0",
    "fflate": "0.8.3",
    "prettier": "3.9.9"
  }
}
