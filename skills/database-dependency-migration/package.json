{
  "name": "database-dependency-migration",
  "version": "0.3.2",
  "description": "Evidence-backed PostgreSQL dependencies and review-only migration analysis",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@12.10.1",
  "bin": {
    "dbdep": "scripts/dbdep.mjs"
  },
  "exports": {
    ".": "./src/dbdep/engine.mjs"
  },
  "files": [
    "src/dbdep/*.mjs",
    "scripts/dbdep.mjs",
    "schemas",
    "assets/viewer",
    "examples",
    "references",
    "SKILL.md",
    "agents",
    "templates",
    "README.md",
    "CONTRIBUTING.md",
    "docs/roadmap.md",
    "pnpm-lock.yaml",
    "LICENSE",
    "SECURITY.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "dbdep": "node scripts/dbdep.mjs",
    "demo": "node scripts/dbdep.mjs demo out/demo --json"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "commander": "15.0.0",
    "libpg-query": "18.1.5",
    "pg": "8.23.1",
    "pg-connection-string": "2.14.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "fflate": "0.8.3",
    "prettier": "3.9.9"
  }
}
